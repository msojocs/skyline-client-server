+/* sbix stores the original Noto PNG glyphs; retain the table until release. */
+struct sbix_image_context
+{
+    struct dwrite_fonttable table;
+};
+
+struct sbix_image
+{
+    const BYTE *data;
+    UINT32 size, ppem, width, height;
+    INT16 x, y;
+};
+
+static UINT16 sbix_u16(const BYTE *p)
+{
+    return (p[0] << 8) | p[1];
+}
+
+static UINT32 sbix_u32(const BYTE *p)
+{
+    return ((UINT32)p[0] << 24) | ((UINT32)p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+static BOOL sbix_png_image(const struct dwrite_fonttable *table, UINT16 glyph, UINT32 glyph_count,
+        UINT32 requested_ppem, struct sbix_image *image)
+{
+    const BYTE *data = table->data, *record, *png;
+    UINT32 count, i, strike, next, start, end, ppem, distance, best = ~0u;
+    BOOL found = FALSE;
+
+    if (!data || table->size < 8 || glyph >= glyph_count || sbix_u16(data) != 1) return FALSE;
+    count = sbix_u32(data + 4);
+    if (count > (table->size - 8) / 4) return FALSE;
+    for (i = 0; i < count; ++i)
+    {
+        strike = sbix_u32(data + 8 + 4 * i);
+        next = i + 1 < count ? sbix_u32(data + 12 + 4 * i) : table->size;
+        if (strike < 8 + 4 * count || strike > next || next > table->size || next - strike < 4 + 4 * (glyph_count + 1)) continue;
+        ppem = sbix_u16(data + strike);
+        if (!ppem) continue;
+        start = sbix_u32(data + strike + 4 + 4 * glyph);
+        end = sbix_u32(data + strike + 8 + 4 * glyph);
+        if (start < 4 + 4 * (glyph_count + 1) || start > end || end > next - strike || end - start < 41) continue;
+        record = data + strike + start;
+        if (memcmp(record + 4, "png ", 4)) continue;
+        png = record + 8;
+        if (memcmp(png, "\x89PNG\r\n\x1a\n", 8) || sbix_u32(png + 8) != 13 || memcmp(png + 12, "IHDR", 4)) continue;
+        distance = ppem > requested_ppem ? ppem - requested_ppem : requested_ppem - ppem;
+        if (found && distance >= best) continue;
+        image->width = sbix_u32(png + 16);
+        image->height = sbix_u32(png + 20);
+        if (!image->width || !image->height || image->width > 65535 || image->height > 65535) continue;
+        image->data = png;
+        image->size = end - start - 8;
+        image->ppem = ppem;
+        image->x = (INT16)sbix_u16(record);
+        image->y = (INT16)sbix_u16(record + 2);
+        best = distance;
+        found = TRUE;
+    }
+    return found;
+}
